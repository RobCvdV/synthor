// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mixer strips > renders an instrument strip 1`] = `"<div class="strip instrument"><div class="actions"><span class="actionsEnd"><button type="button" class="button xs" title="Hide from mixer">Hide</button></span></div><div class="kind">SYN</div><div class="name">Lead</div><div class="spacer"></div><div class="muteSolo"><button type="button" class="button sm" disabled="" title="Not available for instruments yet">M</button><button type="button" class="button sm" disabled="" title="Not available for instruments yet">S</button></div><div class="label">Pan</div><span class="slider pan"><input class="input" min="-1" max="1" step="0.01" type="range" value="0"></span><span class="slider vertical fader"><input class="input" min="0" max="2" step="0.01" type="range" value="1"><span class="readout">100%</span></span><div class="footer"><select class="select small" title="Output channel"><option value="master">Master</option></select></div></div>"`;

exports[`mixer strips > renders the master channel strip 1`] = `"<div class="strip master selectable"><div class="actions"></div><div class="kind">MASTER</div><div class="name">Master</div><div class="spacer"></div><div class="effects"></div><select class="select small block"><option value="">+ Add effect</option><option value="filter">Filter</option><option value="delay">Delay</option><option value="echo">Echo</option><option value="delayS">Stereo Delay</option><option value="echoS">Stereo Echo</option><option value="reverb">Reverb</option><option value="conv">Convolution</option><option value="width">Stereo Width</option><option value="tanh">Saturator</option><option value="clip">Hard Clip</option><option value="fold">Wave Folder</option><option value="crush">Bit Crusher</option><option value="gain">Gain</option><option value="comp">Compressor</option></select><div class="muteSolo"><button type="button" class="button sm" title="Mute">M</button><button type="button" class="button sm" title="Solo">S</button></div><div class="label">Bal</div><span class="slider pan"><input class="input" min="-1" max="1" step="0.01" type="range" value="0"></span><span class="slider vertical fader"><input class="input" min="0" max="2" step="0.01" type="range" value="1"><span class="readout">100%</span></span><div class="footer"></div></div>"`;
