// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`LibraryDialog > lists instruments sorted by name 1`] = `"<div><div class="dialog-overlay" tabindex="-1"><div class="dialog-box dialog"><h3>Add Instruments from Library</h3><div class="toolbar"><input class="search" placeholder="Search name, category, tags…" aria-label="Search library" type="search" value=""><select class="select small" aria-label="Category"><option value="">All categories</option><option value="Bass">Bass</option><option value="Drums">Drums</option><option value="Pads">Pads</option></select><select class="select small" aria-label="Sort by"><option value="name">Sort: Name</option></select><button type="button" class="button sm" title="Ascending" aria-label="Toggle sort direction">↑</button><button type="button" class="button sm" title="Add instrument files to the library (not to the song)">Import…</button></div><div class="body"><div class="listPane"><div class="listHead"><button type="button" class="button xs">Select all</button><span class="muted">0 selected</span></div><ul class="list"><li class="row"><input aria-label="Select acid bass" type="checkbox"><span class="kind" title="Synth">▦</span><span class="name">acid bass</span><span class="category">Bass</span><span class="rowTags"><span class="tag">303</span></span></li><li class="row"><input aria-label="Select Kit 808" type="checkbox"><span class="kind" title="Drum Kit">◆</span><span class="name">Kit 808</span><span class="category">Drums</span><span class="rowTags"><span class="tag">warm</span></span></li><li class="row"><input aria-label="Select Warm Pad" type="checkbox"><span class="kind" title="Synth">▦</span><span class="name">Warm Pad</span><span class="category">Pads</span><span class="rowTags"><span class="tag">warm</span></span></li></ul></div><div class="detail"><p class="muted">Select a instrument to edit its name, category and tags.</p></div></div><div class="dialog-actions"><button type="button" class="button md">Cancel</button><button type="button" class="button md accent" disabled="">Add to song</button></div></div></div></div>"`;
