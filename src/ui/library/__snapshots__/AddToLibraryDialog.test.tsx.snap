// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AddToLibraryDialog > pre-checks the instruments not yet in the library 1`] = `"<div><div class="dialog-overlay" tabindex="-1"><div class="dialog-box narrowDialog"><h3>Add to Library?</h3><p>3 instruments were added to the song. Keep them in your library too?</p><div class="listHead"><button type="button" class="button xs">Select all</button><span class="muted">2 selected</span></div><ul class="checklist"><li><label><input type="checkbox" checked=""><span class="name">Pad</span><span class="muted">pad.synthinst</span></label></li><li><label><input type="checkbox"><span class="name">Bass</span><span class="muted">already in library</span></label></li><li><label><input type="checkbox" checked=""><span class="name">Kit</span><span class="muted">kit.synthinst</span></label></li></ul><div class="dialog-actions"><button type="button" class="button md">Not now</button><button type="button" class="button md accent">Add 2 to library</button></div></div></div></div>"`;
