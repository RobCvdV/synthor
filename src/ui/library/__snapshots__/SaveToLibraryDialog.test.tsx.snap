// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SaveToLibraryDialog > offers replace or keep both when the name is taken 1`] = `"<div><div class="dialog-overlay" tabindex="-1"><div class="dialog-box narrowDialog"><h3>Save to Library</h3><div class="fields"><label class="field"><span>Name</span><input value="pad"></label><label class="field"><span>Category</span><input list="_r_2_" placeholder="e.g. Bass, Pads, Drums" value=""><datalist id="_r_2_"><option value="Pads"></option></datalist></label><div class="field"><span>Tags</span><div class="tags"><input class="tagInput" placeholder="Add tags…" aria-label="Add tag" list="_r_3_" value=""><datalist id="_r_3_"><option value="warm"></option></datalist></div></div></div><div class="dialog-err">“Pad” is already in the library.</div><div class="dialog-actions"><button type="button" class="button md">Cancel</button><button type="button" class="button md">Keep both</button><button type="button" class="button md warn">Replace</button></div></div></div></div>"`;
