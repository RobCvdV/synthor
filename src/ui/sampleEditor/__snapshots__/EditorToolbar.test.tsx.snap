// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EditorToolbar > enables only view controls while the sample is not ready 1`] = `"<div class="toolbar"><button type="button" class="button md" disabled="" title="Play from cursor/selection (Space)">▶ Play</button><button type="button" class="button md" disabled="" title="Draw on the waveform with the mouse">✎ Draw</button><span class="spacer"></span><button type="button" class="button md" disabled="" title="Copy selection to paste buffer (⌘C)">Copy</button><button type="button" class="button md" disabled="" title="Cut selection to paste buffer (⌘X)">Cut</button><button type="button" class="button md" disabled="" title="Paste at cursor, overwriting (⌘V)">Paste</button><button type="button" class="button md" disabled="" title="Insert at cursor, shifting content">Insert</button><button type="button" class="button md" disabled="" title="Replace selection with paste buffer">Replace</button><button type="button" class="button md" disabled="" title="Reverse selection (sounds backwards)">Reverse</button><button type="button" class="button md" disabled="" title="Change volume of selection">Volume…</button><button type="button" class="button md" disabled="" title="Fade selection in (0→100%)">Fade In…</button><button type="button" class="button md" disabled="" title="Fade selection out (100→0%)">Fade Out…</button><select class="select" disabled="" aria-label="Process" title="Process the selection, or the whole sample where nothing is selected"><option value="">Process…</option><option value="trim" disabled="">Trim to selection</option><option value="silence" disabled="">Silence</option><option value="normalize">Normalize</option><option value="removeDc">Remove DC offset</option><option value="pitch">Pitch…</option></select><button type="button" class="button md" disabled="" title="Move the selection edges to the nearest rising zero crossings">Snap</button><button type="button" class="button md" disabled="" title="Make a single-cycle waveform from the selection, for the Sample Waveform module">Make Cycle…</button><span class="spacer"></span><button type="button" class="button md" disabled="" title="Save the edited sample as a new sample in the list">Save As…</button><button type="button" class="button md" disabled="" title="Export sample to file">Export</button><span class="spacer"></span><button type="button" class="button md" title="Zoom out, keeping the selection or cursor centred">zoom −</button><button type="button" class="button md" title="Zoom in, keeping the selection or cursor centred">zoom +</button><button type="button" class="button md" disabled="" title="Zoom to the selection">zoom sel</button><button type="button" class="button md" title="Fit whole sample">zoom fit</button><button type="button" class="button md" title="Close editor">Close ×</button></div>"`;
