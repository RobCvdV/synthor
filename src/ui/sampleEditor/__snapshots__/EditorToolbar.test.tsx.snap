// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EditorToolbar > enables only view controls while the sample is not ready 1`] = `"<div class="toolbar"><button type="button" class="button md" disabled="" title="Play from cursor/selection (Space)">▶ Play</button><span class="spacer"></span><button type="button" class="button md" disabled="" title="Copy selection to paste buffer (⌘C)">Copy</button><button type="button" class="button md" disabled="" title="Cut selection to paste buffer (⌘X)">Cut</button><button type="button" class="button md" disabled="" title="Paste at cursor, overwriting (⌘V)">Paste</button><button type="button" class="button md" disabled="" title="Insert at cursor, shifting content">Insert</button><button type="button" class="button md" disabled="" title="Replace selection with paste buffer">Replace</button><button type="button" class="button md" disabled="" title="Reverse selection (sounds backwards)">Reverse</button><button type="button" class="button md" disabled="" title="Change volume of selection">Volume…</button><button type="button" class="button md" disabled="" title="Fade selection in (0→100%)">Fade In…</button><button type="button" class="button md" disabled="" title="Fade selection out (100→0%)">Fade Out…</button><span class="spacer"></span><button type="button" class="button md" disabled="" title="Save the edited sample as a new sample in the list">Save As…</button><button type="button" class="button md" disabled="" title="Export sample to file">Export</button><span class="spacer"></span><button type="button" class="button md" title="Zoom out">zoom −</button><button type="button" class="button md" title="Zoom in">zoom +</button><button type="button" class="button md" title="Fit whole sample">zoom fit</button><button type="button" class="button md" title="Close editor">Close ×</button></div>"`;
