// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProcessPanel > shows each param and reports slider, Done and Cancel 1`] = `"<div class="processPanel" role="group" aria-label="Crush"><strong>Crush</strong><span class="muted">whole sample</span><label class="processParam"><span>Bits</span><span class="slider processSlider"><input class="input" min="1" max="16" step="1" type="range" value="8"></span><input class="processNumber" aria-label="Bits" min="1" max="16" step="1" type="number" value="8"><span class="muted">bit</span></label><label class="processParam"><span>Rate</span><span class="slider processSlider"><input class="input" min="1" max="32" step="1" type="range" value="2"></span><input class="processNumber" aria-label="Rate" min="1" max="32" step="1" type="number" value="2"><span class="muted">÷</span><span class="processInfo">22.1 kHz</span></label><span class="spacer"></span><button type="button" class="button md" title="Loop the processed range while tuning (Space plays as usual)">▶ Loop</button><button type="button" class="button md" title="Back to the original (Esc)">Cancel</button><button type="button" class="button md" title="Apply as one undoable edit (Enter)">Done</button></div>"`;
