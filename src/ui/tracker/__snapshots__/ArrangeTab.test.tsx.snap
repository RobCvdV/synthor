// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ArrangeTab > marks the current step, telling repeats of a pattern apart 1`] = `"<div class="arrange-tab"><div class="arrange-palette"><div class="arrange-palette-head"><span class="arrange-palette-title">Patterns</span><button type="button" class="button sm">+ New</button></div><div class="arrange-palette-list"><div class="arrange-palette-item current" draggable="true"><span class="arrange-palette-name" title="Double-click to rename">Pattern 01</span><span class="arrange-palette-meta">32r</span><span class="arrange-palette-actions"><button class="arrange-palette-action-btn" title="Duplicate pattern">⧉</button><button class="arrange-palette-action-btn" title="Delete pattern">×</button></span></div><div class="arrange-palette-item" draggable="true"><span class="arrange-palette-name" title="Double-click to rename">Second</span><span class="arrange-palette-meta">32r</span><span class="arrange-palette-actions"><button class="arrange-palette-action-btn" title="Duplicate pattern">⧉</button><button class="arrange-palette-action-btn" title="Delete pattern">×</button></span></div></div></div><div><div class="arrange-section selected"><div class="arrange-section-head" title="Click to make this the current section" draggable="true"><span class="arrange-section-arrows"></span><span class="arrange-section-name" title="Double-click to rename">Intro</span><button class="arrange-del-btn" title="Remove section">×</button></div><ul class="arrange-pattern-list"><li><div class="arrange-pattern-item" data-pat-id="<id>" draggable="true"><span class="arrange-pattern-num">1</span><span class="arrange-pattern-name" title="Double-click to rename">Pattern 01</span><button class="arrange-del-btn" title="Remove pattern from section">×</button></div></li><li><div class="arrange-pattern-item" data-pat-id="<id>" draggable="true"><span class="arrange-pattern-num">2</span><span class="arrange-pattern-name" title="Double-click to rename">Second</span><button class="arrange-del-btn" title="Remove pattern from section">×</button></div></li><li><div class="arrange-pattern-item current" data-pat-id="<id>" draggable="true"><span class="arrange-pattern-num">3</span><span class="arrange-pattern-name" title="Double-click to rename">Pattern 01</span><button class="arrange-del-btn" title="Remove pattern from section">×</button></div></li><li class="arrange-pattern-item arrange-add-item"><select class="arrange-add-select"><option value="">+ add pattern</option><option value="<id>">Pattern 01</option><option value="<id>">Second</option></select></li></ul></div></div><div class="arrange-drop-zone"><span class="arrange-drop-zone-label">Drop pattern here to create new section</span></div><div class="arrange-actions"><button type="button" class="button sm">+ Section</button></div></div>"`;
