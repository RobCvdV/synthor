// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StorageLocation > names browser storage on the web 1`] = `"<p class="muted store-location"><span class="store-location-path">Stored in this browser</span></p><p class="muted store-location"><button type="button" class="button sm" title="Download all songs, instruments and samples as one zip">Back up library</button><button type="button" class="button sm" title="Add songs, instruments and samples from a backup zip">Restore…</button></p>"`;

exports[`StorageLocation > shows a local library in Electron, reveals and changes it, and offers iCloud Drive 1`] = `"<p class="muted store-location"><span class="store-location-path" title="/Users/me/Documents/Synthor">~/Documents/Synthor</span><button type="button" class="button sm" title="Show the library folder">Reveal</button><button type="button" class="button sm" title="Keep the library in another folder">Change…</button></p><p class="muted store-location"><span class="store-location-path" title="/Users/me/Library/Mobile Documents/iCloud~nl~akiar~synthor/Documents">iCloud Drive is available</span><button type="button" class="button sm" title="Keep the library in iCloud Drive › Synthor, synced to your other devices">Move to iCloud Drive…</button></p><p class="muted store-location"><button type="button" class="button sm" title="Download all songs, instruments and samples as one zip">Back up library</button><button type="button" class="button sm" title="Add songs, instruments and samples from a backup zip">Restore…</button></p>"`;
