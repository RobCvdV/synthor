exports[`GameView > says so when the song has no game settings 1`] = `
<div>
  <div
    class="view"
  >
    <div
      class="intro"
    >
      <p
        class="empty"
      >
        This song has no game settings. A game conducts a song from them: its sections by energy, the parts a DJ plays with, moods, fills and stingers.
      </p>
      <button
        class="button md"
        type="button"
      >
        Add game settings
      </button>
    </div>
  </div>
</div>
`;

