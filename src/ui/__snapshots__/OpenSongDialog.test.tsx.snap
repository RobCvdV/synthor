// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OpenSongDialog > lists songs by name and marks the open one 1`] = `"<div><div class="dialog-overlay" tabindex="-1"><div class="dialog-box narrowDialog"><h3>Open Song</h3><input class="search searchBlock" placeholder="Search songs…" aria-label="Search songs" type="search" value=""><ul class="checklist"><li class="row"><span class="name">ambient drift</span></li><li class="row"><span class="name">Groove</span><span class="muted">open now</span></li><li class="row"><span class="name">Groove Night</span></li></ul><div class="dialog-actions"><button type="button" class="button md">Cancel</button><button type="button" class="button md accent" disabled="">Open</button></div></div></div></div>"`;
