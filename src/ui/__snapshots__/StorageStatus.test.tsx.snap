exports[`StorageStatus > shows a slow read, marks it as an iCloud download, and offers the folder once unavailable 1`] = `"<div class="storage-status unavailable" role="alert"><span>The library isn't available: iCloud hasn't delivered songs/a/song.json after 22 s. Check your internet connection and free disk space. Synthor carries on as soon as it arrives.</span><button type="button" class="button sm">Show Library Folder</button></div>"`;
