// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`InstrumentSettings > renders a synth with the live voices setting 1`] = `"<aside class="inst-settings"><div class="inst-settings-head"><input class="inst-name-input" value="Lead Synth"><span class="muted">Synth</span><div class="inst-settings-actions"><button title="Duplicate this instrument">Duplicate</button><button>Export</button><button title="Delete instrument">Delete</button></div></div><div class="inst-settings-body"><div class="inst-setting-row"><span class="inst-setting-label" title="Polyphony when playing this instrument in free play">Live Voices</span><select class="inst-setting-select"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option><option value="9">9</option><option value="10">10</option><option value="11">11</option><option value="12">12</option><option value="13">13</option><option value="14">14</option><option value="15">15</option><option value="16">16</option></select></div><h4>Effect Ranges</h4><div class="inst-setting-row"><span class="inst-setting-label" title="vibratoRate">Vib Rate Max</span><select class="inst-setting-select"><option value="25">25 Hz</option><option value="50">50 Hz</option><option value="100">100 Hz</option><option value="200">200 Hz</option><option value="500">500 Hz</option><option value="1000">1000 Hz</option></select></div><div class="inst-setting-row"><span class="inst-setting-label" title="vibratoDepth">Vib Depth Max</span><select class="inst-setting-select"><option value="1">1 st</option><option value="2">2 st</option><option value="6">6 st</option><option value="12">12 st</option><option value="24">24 st</option><option value="48">48 st</option></select></div><div class="inst-setting-row"><span class="inst-setting-label" title="tremoloRate">Trm Rate Max</span><select class="inst-setting-select"><option value="25">25 Hz</option><option value="50">50 Hz</option><option value="100">100 Hz</option><option value="200">200 Hz</option><option value="500">500 Hz</option><option value="1000">1000 Hz</option></select></div><div class="inst-setting-row"><span class="inst-setting-label" title="tremoloDepth">Trm Depth Max</span><select class="inst-setting-select"><option value="1">1 ×</option><option value="2">2 ×</option></select></div><div class="inst-setting-row"><span class="inst-setting-label" title="portamento">Porta Max</span><select class="inst-setting-select"><option value="1">1 st</option><option value="2">2 st</option><option value="6">6 st</option><option value="12">12 st</option><option value="24">24 st</option><option value="48">48 st</option></select></div></div></aside>"`;
