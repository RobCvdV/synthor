// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CreateSampleDialog > creates a single cycle of the chosen length, named after the shape 1`] = `"<div class="dialog-overlay" tabindex="-1"><div class="dialog-box"><form><div class="dialog-row"><label>Waveform</label><select><option value="sine">sine</option><option value="square">square</option><option value="saw">saw</option><option value="triangle">triangle</option><option value="noise">noise</option></select></div><div class="dialog-row"><label>Length</label><select><option value="256">256 frames</option><option value="512">512 frames</option><option value="1024">1024 frames</option><option value="2048">2048 frames</option><option value="4096">4096 frames</option></select></div><div class="dialog-row"><label>Name</label><input value="sine"></div><div class="dialog-actions"><button type="submit" class="button md">Create</button><button type="button" class="button md">Cancel</button></div></form></div></div>"`;
