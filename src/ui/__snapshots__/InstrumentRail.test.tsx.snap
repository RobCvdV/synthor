exports[`InstrumentRail > renders the add menu, library button and instrument list 1`] = `"<aside class="inst-rail"><div class="inst-rail-actions"><select class="select inst-add" aria-label="Add instrument"><option value="">Add Instrument +</option><option value="library">From library…</option><option value="import">Import…</option><option value="synth">New Synth…</option><option value="drumkit">New Drum Kit…</option></select><button type="button" class="button sm" title="Manage the instrument library">Library</button></div><ul class="inst-list"><li class="inst-item selected"><span class="inst-kind">▦</span><span class="inst-name" title="Lead Synth">Lead Synth</span><span class="inst-uses" title="1 track(s) use this">1</span></li><li class="inst-item"><span class="inst-kind">◆</span><span class="inst-name" title="Drum Kit">Drum Kit</span><span class="inst-uses" title="1 track(s) use this">1</span></li></ul></aside>"`;
