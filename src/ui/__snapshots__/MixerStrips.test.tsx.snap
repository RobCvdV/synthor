// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mixer strips > renders the master channel strip 1`] = `"<div style="display: flex; flex-direction: column; align-items: center; width: 80px; padding: 4px; border: 1px solid rgb(85, 85, 85); box-shadow: 0 0 0 1px #555; border-radius: 4px; background: rgb(26, 26, 62); flex-shrink: 0; gap: 4px; cursor: pointer;"><div style="display: flex; align-items: center; width: 100%; gap: 1px;"><div style="flex: 1 1 0%; font-size: 10px; font-weight: bold; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Master</div></div><div style="font-size: 8px; color: rgb(136, 136, 136);">MASTER</div><div style="flex: 1 1 0%; min-height: 4px;"></div><div style="width: 100%; display: flex; flex-direction: column; gap: 1px; overflow-y: auto; max-height: 80px; min-height: 0px;"></div><select class="mixer-dropdown" style="font-size: 9px; width: 100%;"><option value="">+ Add effect</option><option value="filter">Filter</option><option value="delay">Delay</option><option value="echo">Echo</option><option value="delayS">Stereo Delay</option><option value="echoS">Stereo Echo</option><option value="reverb">Reverb</option><option value="conv">Convolution</option><option value="width">Stereo Width</option><option value="tanh">Saturator</option><option value="clip">Hard Clip</option><option value="fold">Wave Folder</option><option value="crush">Bit Crusher</option><option value="gain">Gain</option><option value="comp">Compressor</option></select><div style="display: flex; gap: 4px; margin-top: 2px;"><button class="octbtn" style="font-size: 9px; padding: 1px 5px;">M</button><button class="octbtn" style="font-size: 9px; padding: 1px 5px;">S</button></div><div style="font-size: 8px; color: rgb(170, 170, 170);">Bal</div><span style="display: block; align-items: center; gap: 2px; width: 100%;"><input min="-1" max="1" step="0.01" style="width: 100%; height: 14px;" type="range" value="0"></span><div style="display: flex; flex-direction: column; align-items: center; flex: 0 1 40%; min-height: 60px;"><span style="display: inline-flex; align-items: center; gap: 2px; flex: 1 1 0%; min-height: 0px;"><input min="0" max="2" step="0.01" style="writing-mode: vertical-lr; direction: rtl; width: 14px; align-self: stretch;" type="range" value="1"><span style="font-size: 10px; color: var(--muted); min-width: 32px; text-align: right;">100%</span></span></div><div style="height: 18px; margin-top: 2px; flex-shrink: 0;"></div></div>"`;
