{
  "name": "synthor",
  "private": true,
  "version": "0.0.0",
  "description": "Modular web-based tracker synth on Elementary Audio",
  "author": "Rob Coenen",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite --config vite.electron.config.ts\" \"wait-on http://localhost:5193 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "npm run electron:compile && npm run electron:native && vite build --config vite.electron.config.ts && electron-builder",
    "electron:dist": "npm run electron:compile && npm run electron:native && vite build --config vite.electron.config.ts && electron-builder --dir",
    "deploy": "node scripts/deploy.js",
    "build-deploy": "npm run build && npm run deploy",
    "electron:native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@elemaudio/core": "^4.0.1",
    "@elemaudio/web-renderer": "file:vendor/elementary-js/web-renderer",
    "@xyflow/react": "^12.11.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "immer": "^11.1.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@elemaudio/offline-renderer": "file:vendor/elementary-js/offline-renderer",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "basic-ftp": "^6.0.2",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "node-gyp": "^13.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "nl.akiar.synthor",
    "afterPack": "scripts/adhoc-sign.cjs",
    "productName": "Synthor",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "RobCvdV",
      "repo": "synthor"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "synthor",
        "name": "Synthor Song",
        "description": "Synthor song with its samples",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "native/icloud/build/Release/icloud.node",
          "to": "icloud.node"
        }
      ],
      "extendInfo": {
        "NSUbiquitousContainers": {
          "iCloud.nl.akiar.synthor": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Synthor",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "guid": "cf1c9294-a5d4-5539-8a0a-de5153d6f4a1"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
